# ─────────────────────────────────────────────────────────────────────────────
# DEPRECATED — secrets are managed in Doppler now.
#   doppler login && doppler setup
#   npm run dev               (auto-injects env via `doppler run --`)
#
# Use this file ONLY as a fallback / reference. To populate a real .env.local
# from Doppler:   npm run env:pull
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — public values (browser + server)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Schema — keeps Hotties tables separate from Trauma Box
SUPABASE_DB_SCHEMA=hotties

# Cron auth — generate with: openssl rand -hex 32
CRON_SECRET=replace-with-random-hex

# Local dev URL (used by server components calling /api/slots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# LA City Rec & Parks — required by the la_rec scraper. Server only.
# Sign up at: https://reg.recreation.parks.lacity.gov/web/wbwsc/webtrac.wsc/splash.html
# ─────────────────────────────────────────────────────────────────────────────
LA_REC_USERNAME=
LA_REC_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# LLM providers — /api/ask uses whichever is configured.
# Priority: openai > groq > gemini. Force one with LLM_PROVIDER=openai|groq|gemini.
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Groq — https://console.groq.com (free tier, very fast Llama inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey (generous free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional explicit override:
# LLM_PROVIDER=groq

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps Platform — https://console.cloud.google.com/google/maps-apis
# Enable: Geocoding API, Maps Static API, Maps JavaScript API, Directions API,
# Places API (New). Restrict the secret key by IP, public key by HTTP referrer.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Open-Meteo weather — no key required, used directly by src/lib/weather.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Unsplash — facility hero imagery. https://unsplash.com/developers
# ─────────────────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional / future
# ─────────────────────────────────────────────────────────────────────────────
# AssemblyAI — voice search (speech-to-text). https://www.assemblyai.com/
# ASSEMBLYAI_API_KEY=
#
# Hugging Face Inference API. https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=
#
# AirNow (EPA air quality, free, very LA-relevant during fire season).
# https://docs.airnowapi.org/
# AIRNOW_API_KEY=
# Supabase — public values (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Schema — keeps Hotties tables separate from Trauma Box
SUPABASE_DB_SCHEMA=hotties

# Cron auth — generate with: openssl rand -hex 32
CRON_SECRET=replace-with-random-hex

# Local dev URL (used by server components calling /api/slots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI — server only. Used by /api/ask for natural-language slot search.
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o-mini
